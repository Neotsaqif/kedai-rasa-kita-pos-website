VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Backend switcher: "mysql" (default, local XAMPP) or "supabase" (cloud).
# Setting "supabase" restores the original Supabase-only behaviour.
VITE_DB_BACKEND=mysql

# Absolute URL to the PHP/PDO MySQL API (XAMPP/Apache). Used only when
# VITE_DB_BACKEND=mysql. Behind the Vite dev proxy you may also use "/api".
VITE_API_BASE_URL=http://localhost/kedai-rasa-kita-pos-website/backend/api/index.php

# Default Testing Credentials (MySQL seed, see backend/sql/seed.php):
# Admin  : admin@rasakita.id / password123
# Cashier: kasir@rasakita.id / password123
